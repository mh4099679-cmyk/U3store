theme) {\n        fetch('/api/theme', {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify({ theme: theme, scope: 'store' })\n        }).then(() => location.reload());\n    }\n    </script>\n\n\n<div style=\"max-width:1100px;margin:40px auto 100px;padding:0 24px;\">\n    <h1 style=\"font-size:28px;font-weight:900;letter-spacing:1px;margin-bottom:30px;text-transform:uppercase;\">\n        إتمام الطلب بأمان    </h1>\n\n    <div style=\"display:grid;grid-template-columns:1fr 380px;gap:40px;align-items:flex-start;\">\n        <!-- Form Column -->\n        <form id=\"checkout-form\" onsubmit=\"handlePlaceOrder(event)\" style=\"display:flex;flex-direction:column;gap:30px;\">\n            <!-- Customer & Delivery -->\n            <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:28px;\">\n                <h3 style=\"font-size:16px;font-weight:900;letter-spacing:1px;margin-bottom:20px;text-transform:uppercase;\">\n                    1. بيانات التوصيل والتواصل                </h3>\n\n                <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;\">\n                    <div>\n                        <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">الاسم بالكامل *</label>\n                        <input type=\"text\" id=\"cust-name\" required value=\"\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                    </div>\n                    <div>\n                        <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">رقم المحمول (010 / 011 / 012 / 015) *</label>\n                        <input type=\"tel\" id=\"cust-phone\" required placeholder=\"01012345678\" value=\"\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;direction:ltr;text-align:right;\">\n                    </div>\n                </div>\n\n                <div style=\"margin-bottom:16px;\">\n                    <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">البريد الإلكتروني (اختياري للزائر)</label>\n                    <input type=\"email\" id=\"cust-email\" value=\"\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                </div>\n\n                <!-- Governorate & City & Area -->\n                <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;\">\n                    <div>\n                        <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">المحافظة *</label>\n                        <select id=\"cust-gov\" required onchange=\"handleGovChange(this.value)\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:#18181b;color:inherit;\">\n                            <option value=\"\">-- اختر المحافظة... --</option>\n                                                        <option value=\"gov-01\" data-rate=\"\">\n                                القاهرة (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-02\" data-rate=\"\">\n                                الجيزة (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-03\" data-rate=\"\">\n                                الإسكندرية (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-04\" data-rate=\"\">\n                                القليوبية (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-05\" data-rate=\"59.00\">\n                                الشرقية (59 ج.م)\n                            </option>\n                                                        <option value=\"gov-06\" data-rate=\"\">\n                                الدقهلية (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-07\" data-rate=\"\">\n                                الغربية (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-08\" data-rate=\"\">\n                                المنوفية (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-09\" data-rate=\"\">\n                                البحيرة (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-10\" data-rate=\"\">\n                                كفر الشيخ (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-11\" data-rate=\"\">\n                                دمياط (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-12\" data-rate=\"\">\n                                بورسعيد (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-13\" data-rate=\"\">\n                                الإسماعيلية (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-14\" data-rate=\"\">\n                                السويس (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-15\" data-rate=\"\">\n                                شمال سيناء (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-16\" data-rate=\"\">\n                                جنوب سيناء (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-17\" data-rate=\"\">\n                                بني سويف (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-18\" data-rate=\"\">\n                                الفيوم (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-19\" data-rate=\"\">\n                                المنيا (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-20\" data-rate=\"\">\n                                أسيوط (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-21\" data-rate=\"\">\n                                سوهاج (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-22\" data-rate=\"\">\n                                قنا (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-23\" data-rate=\"\">\n                                الأقصر (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-24\" data-rate=\"\">\n                                أسوان (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-25\" data-rate=\"\">\n                                البحر الأحمر (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-26\" data-rate=\"\">\n                                الوادي الجديد (0 ج.م)\n                            </option>\n                                                        <option value=\"gov-27\" data-rate=\"\">\n                                مطروح (0 ج.م)\n                            </option>\n                                                    </select>\n                    </div>\n                    <div>\n                        <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">المدينة / المركز *</label>\n                        <input type=\"text\" id=\"cust-city\" required placeholder=\"مثال: مدينة نصر / المنصورة\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                    </div>\n                </div>\n\n                <div style=\"margin-bottom:16px;\">\n                    <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">المنطقة / الحي *</label>\n                    <input type=\"text\" id=\"cust-area\" required placeholder=\"مثال: الحي السابع / منطقة الجامعة\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                </div>\n\n                <div style=\"margin-bottom:16px;\">\n                    <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">اسم الشارع، رقم العقار، الدور، الشقة *</label>\n                    <input type=\"text\" id=\"cust-street\" required placeholder=\"اسم الشارع بالتفصيل\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                </div>\n\n                <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px;\">\n                    <div>\n                        <label style=\"display:block;font-size:11px;font-weight:800;margin-bottom:6px;\">رقم العقار *</label>\n                        <input type=\"text\" id=\"cust-bldg\" required placeholder=\"14\" style=\"width:100%;height:42px;border:1px solid #d4d4d8;border-radius:8px;padding:0 10px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                    </div>\n                    <div>\n                        <label style=\"display:block;font-size:11px;font-weight:800;margin-bottom:6px;\">الدور</label>\n                        <input type=\"text\" id=\"cust-floor\" placeholder=\"3\" style=\"width:100%;height:42px;border:1px solid #d4d4d8;border-radius:8px;padding:0 10px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                    </div>\n                    <div>\n                        <label style=\"display:block;font-size:11px;font-weight:800;margin-bottom:6px;\">رقم الشقة</label>\n                        <input type=\"text\" id=\"cust-apt\" placeholder=\"12\" style=\"width:100%;height:42px;border:1px solid #d4d4d8;border-radius:8px;padding:0 10px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                    </div>\n                </div>\n\n                <div>\n                    <label style=\"display:block;font-size:12px;font-weight:800;margin-bottom:6px;\">ملاحظات إضافية للتوصيل (اختياري)</label>\n                    <input type=\"text\" id=\"cust-notes\" placeholder=\"ملاحظات تسليم خاصة لشركة الشحن\" style=\"width:100%;height:44px;border:1px solid #d4d4d8;border-radius:8px;padding:0 14px;font-size:13px;box-sizing:border-box;background:none;color:inherit;\">\n                </div>\n            </div>\n\n            <!-- Payment Method Selection -->\n            <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:28px;\">\n                <h3 style=\"font-size:16px;font-weight:900;letter-spacing:1px;margin-bottom:20px;text-transform:uppercase;\">\n                    2. طريقة الدفع                </h3>\n\n                <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;\">\n                    <label style=\"border:2px solid #111214;border-radius:12px;padding:16px;display:flex;align-items:center;gap:12px;cursor:pointer;background:#27272a;\">\n                        <input type=\"radio\" name=\"payment_method\" value=\"INSTAPAY\" checked onchange=\"handlePaymentChange(this.value)\">\n                        <div>\n                            <div style=\"font-size:14px;font-weight:800;\">InstaPay Egypt</div>\n                            <div style=\"font-size:11px;color:#71717a;\">تحويل بنكي لحظي 24/7</div>\n                        </div>\n                    </label>\n\n                    <label style=\"border:1px solid #d4d4d8;border-radius:12px;padding:16px;display:flex;align-items:center;gap:12px;cursor:pointer;\">\n                        <input type=\"radio\" name=\"payment_method\" value=\"VODAFONE_CASH\" onchange=\"handlePaymentChange(this.value)\">\n                        <div>\n                            <div style=\"font-size:14px;font-weight:800;\">Vodafone Cash</div>\n                            <div style=\"font-size:11px;color:#71717a;\">محافظ المحمول المصرية</div>\n                        </div>\n                    </label>\n                </div>\n\n                <!-- Payment Details Box -->\n                <div id=\"payment-info-box\" style=\"background:rgba(0,0,0,0.04);border-radius:10px;padding:16px;font-size:13px;line-height:1.6;\">\n                    <strong>بيانات التحويل عبر إنستاباي:</strong><br>\n                    اسم الحساب: <code>U3STORE.INSTAPAY</code><br>\n                    أو عبر رقم الهاتف: <code>01000000000</code><br>\n                    <span style=\"color:#71717a;font-size:11px;\">(يمكنك إتمام الطلب الآن ورفع صورة الإيصال فوراً في الخطوة التالية أو في صفحة تتبع الطلب).</span>\n                </div>\n            </div>\n\n            <button type=\"submit\" id=\"btn-submit-order\" style=\"width:100%;height:54px;background:#111214;color:#ffffff;border:none;border-radius:10px;font-size:14px;font-weight:900;letter-spacing:1px;cursor:pointer;transition:0.2s;\" onmouseover=\"this.style.background='#27272a'\" onmouseout=\"this.style.background='#111214'\">\n                تأكيد الطلب الآن →\n            </button>\n        </form>\n\n        <!-- Summary Column -->\n        <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:24px;box-shadow:0 4px 16px rgba(0,0,0,0.03);\">\n            <h3 style=\"font-size:16px;font-weight:900;letter-spacing:1px;margin-bottom:20px;text-transform:uppercase;\">\n                checkout.order_summary            </h3>\n\n            <div style=\"display:flex;flex-direction:column;gap:12px;margin-bottom:20px;\">\n                            </div>\n\n            <div style=\"border-top:1px solid rgba(255,255,255,0.08);padding-top:16px;display:flex;flex-direction:column;gap:10px;font-size:14px;\">\n                <div style=\"display:flex;justify-content:space-between;color:#71717a;\">\n                    <span>المجموع الفرعي:</span>\n                    <span>0 ج.م</span>\n                </div>\n                                <div style=\"display:flex;justify-content:space-between;color:#71717a;\">\n                    <span>checkout.shipping_fee:</span>\n                    <span id=\"summary-shipping\">-- ج.م</span>\n                </div>\n                <div style=\"border-top:2px solid #111214;padding-top:12px;display:flex;justify-content:space-between;align-items:center;font-size:18px;font-weight:900;\">\n                    <span>checkout.total:</span>\n                    <span id=\"summary-total\">0 ج.م</span>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\nlet currentShippingRate = 0;\nconst cartSubtotal = 0;\n\nfunction handleGovChange(govId) {\n    const sel = document.getElementById('cust-gov');\n    const opt = sel.options[sel.selectedIndex];\n    currentShippingRate = parseFloat(opt.getAttribute('data-rate') || 0);\n\n    document.getElementById('summary-shipping').textContent = currentShippingRate.toLocaleString() + ' ج.م';\n    const finalTotal = cartSubtotal + currentShippingRate;\n    document.getElementById('summary-total').textContent = finalTotal.toLocaleString() + ' ج.م';\n}\n\nfunction handlePaymentChange(method) {\n    const box = document.getElementById('payment-info-box');\n    if (method === 'VODAFONE_CASH') {\n        box.innerHTML = '<strong>بيانات التحويل عبر فودافون كاش:</strong><br>الرقم: <code>01000000000</code><br><span style=\"color:#71717a;font-size:11px;\">يرجى تحويل القيمة وحفظ رسالة التأكيد أو لقطة الشاشة لرفعها.</span>';\n    } else {\n        box.innerHTML = '<strong>بيانات التحويل عبر إنستاباي:</strong><br>اسم الحساب: <code>U3STORE.INSTAPAY</code><br>أو عبر رقم الهاتف: <code>01000000000</code><br><span style=\"color:#71717a;font-size:11px;\">تحويل لحظي مباشر 24/7.</span>';\n    }\n}\n\nfunction handlePlaceOrder(e) {\n    e.preventDefault();\n    const btn = document.getElementById('btn-submit-order');\n    btn.disabled = true;\n    btn.textContent = 'جاري تأكيد الطلب...';\n\n    const payload = {\n        fullName: document.getElementById('cust-name').value.trim(),\n        phone: document.getElementById('cust-phone').value.trim(),\n        email: document.getElementById('cust-email').value.trim(),\n        governorateId: document.getElementById('cust-gov').value,\n        cityName: document.getElementById('cust-city').value.trim(),\n        areaName: document.getElementById('cust-area').value.trim(),\n        streetAddress: document.getElementById('cust-street').value.trim(),\n        buildingNumber: document.getElementById('cust-bldg').value.trim(),\n        floorNumber: document.getElementById('cust-floor').value.trim(),\n        apartmentNumber: document.getElementById('cust-apt').value.trim(),\n        deliveryNotes: document.getElementById('cust-notes').value.trim(),\n        paymentMethodCode: document.querySelector('input[name=\"payment_method\"]:checked').value\n    };\n\n    fetch('/api/checkout', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify(payload)\n    })\n    .then(r => r.json())\n    .then(data => {\n        if (!data.ok) {\n            alert(data.error || 'حدث خطأ أثناء إتمام الطلب.');\n            btn.disabled = false;\n            btn.textContent = 'تأكيد الطلب الآن →';\n        } else {\n            location.href = data.redirectUrl;\n        }\n    })\n    .catch(err => {\n        alert('Network error. Please try again.');\n        btn.disabled = false;\n        btn.textContent = 'تأكيد الطلب الآن →';\n    });\n}\n</script>\n\n    <!-- Store Footer -->\n    <footer style=\"background:#0a0a0b;color:#a1a1aa;padding:60px 24px 100px;border-top:1px solid rgba(255,255,255,0.08);margin-top:auto;\">\n        <div style=\"max-width:1440px;margin:auto;display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:40px;\">\n            <!-- Brand Column -->\n            <div>\n                <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:16px;\">\n                    <img src=\"/assets/img/logo.jpg\" alt=\"U3 STORE\" style=\"width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,0.2);\">\n                    <div>\n                        <div style=\"color:#ffffff;font-size:18px;font-weight:900;letter-spacing:1px;\">U3 STORE</div>\n                        <div style=\"color:#71717a;font-size:11px;font-weight:700;letter-spacing:1px;\"><br />\n<b>Warning</b>:  Undefined array key \"tagline_ar\" in <b>D:\\U3store\\staging_deployment_package\\htdocs\\includes\\footer.php</b> on line <b>27</b><br />\n<br />\n<b>Deprecated</b>:  htmlspecialchars(): Passing null 