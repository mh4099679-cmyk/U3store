me) {\n        fetch('/api/theme', {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify({ theme: theme, scope: 'store' })\n        }).then(() => location.reload());\n    }\n    </script>\n\n\n<div style=\"max-width:1100px;margin:40px auto 100px;padding:0 24px;\">\n    <h1 style=\"font-size:28px;font-weight:900;letter-spacing:1px;margin-bottom:30px;text-transform:uppercase;\">\n        سلة المشتريات    </h1>\n\n        <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:60px 24px;text-align:center;\">\n        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#71717a\" stroke-width=\"1.5\" style=\"margin:0 auto 16px;\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg>\n        <h3 style=\"font-size:18px;font-weight:800;margin-bottom:8px;\">سلة مشترياتك فارغة حالياً.</h3>\n        <p style=\"font-size:14px;color:#71717a;margin-bottom:24px;\">Discover our latest sneaker drops and luxury streetwear essentials.</p>\n        <a href=\"/shop\" style=\"background:#111214;color:#ffffff;padding:12px 32px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:800;letter-spacing:1px;display:inline-block;\">EXPLORE SHOP →</a>\n    </div>\n    </div>\n\n<script>\nfunction updateQty(itemId, nextQty) {\n    fetch('/api/cart', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify({ action: 'update_quantity', itemId: itemId, quantity: nextQty })\n    }).then(() => location.reload());\n}\n\nfunction removeItem(itemId) {\n    fetch('/api/cart', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify({ action: 'remove', itemId: itemId })\n    }).then(() => location.reload());\n}\n\nfunction applyCoupon() {\n    const code = document.getElementById('coupon-input').value.trim();\n    fetch('/api/cart', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify({ action: 'apply_coupon', code: code })\n    })\n    .then(r => r.json())\n    .then(data => {\n        if (!data.ok) {\n            alert(data.error || 'Invalid coupon.');\n        } else {\n            location.reload();\n        }\n    });\n}\n</script>\n\n    <!-- Store Footer -->\n    <footer style=\"background:#0a0a0b;color:#a1a1aa;padding:60px 24px 100px;border-top:1px solid rgba(255,255,255,0.08);margin-top:auto;\">\n        <div style=\"max-width:1440px;margin:auto;display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:40px;\">\n            <!-- Brand Column -->\n            <div>\n                <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:16px;\">\n                    <img src=\"/assets/img/logo.jpg\" alt=\"U3 STORE\" style=\"width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,0.2);\">\n                    <div>\n                        <div style=\"color:#ffffff;font-size:18px;font-weight:900;letter-spacing:1px;\">U3 STORE</div>\n                        <div style=\"color:#71717a;font-size:11px;font-weight:700;letter-spacing:1px;\"><br />\n<b>Warning</b>:  Undefined array key \"tagline_ar\" in <b>D:\\U3store\\staging_deployment_package\\htdocs\\includes\\footer.php</b> on line <b>27</b><br />\n<br />\n<b>Deprecated</b>:  htmlspecialchars(): Passing null to parameter #1 ($string) of type string is deprecated in <b>D:\\U3store\\staging_deployment_package\\htdocs\\includes\\footer.php</b> on line <b>27</b><br />\n</div>\n                    </div>\n                </div>\n                <p style=\"font-size:13px;line-height:1.7;color:#a1a1aa;margin-bottom:20px;\">\n                    <br />\n<b>Warning</b>:  Undefined array key \"about_ar\" in <b>D:\\U3store\\staging_deployment_package\\htdocs\\includes\\footer.php</b> o