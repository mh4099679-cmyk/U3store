    "data": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=5.0\">\n    <title>Streetwear &amp; Footwear — U3 STORE — LIVE YOURS.</title>\n    <link rel=\"icon\" href=\"/assets/img/favicon.ico\">\n    <link rel=\"stylesheet\" href=\"/assets/css/8333f2f5b9d85243.css\">\n    <link rel=\"stylesheet\" href=\"/assets/css/baf6d2176b925d94.css\">\n    <style>\n        :root {\n            --u3-bg: #111214;\n            --u3-surface: #1A1C1F;\n            --u3-text: #F5F5F5;\n        }\n        body {\n            background-color: var(--u3-bg);\n            color: var(--u3-text);\n            font-family: 'Tajawal', -apple-system, BlinkMacSystemFont, sans-serif;\n            margin: 0;\n            padding: 0;\n            overflow-x: hidden;\n            -webkit-font-smoothing: antialiased;\n        }\n        .u3-navbar {\n            background: #111214;\n            color: #ffffff;\n            border-bottom: 1px solid rgba(255,255,255,0.08);\n            position: sticky;\n            top: 0;\n            z-index: 100;\n        }\n        .nav-link {\n            font-size: 13px;\n            font-weight: 700;\n            letter-spacing: 0.05em;\n            color: #d1d5db;\n            text-decoration: none;\n            padding: 6px 12px;\n            border-radius: 6px;\n            transition: color 0.15s, background 0.15s;\n            position: relative;\n        }\n        .nav-link:hover {\n            color: #ffffff;\n        }\n        .nav-link.active {\n            color: #ffffff;\n        }\n        .nav-link.active::after {\n            content: '';\n            position: absolute;\n            bottom: -16px;\n            left: 12px;\n            right: 12px;\n            height: 2px;\n            background: #ffffff;\n            border-radius: 2px;\n        }\n        .theme-pill, .lang-pill {\n            display: inline-flex;\n            align-items: center;\n            border: 1px solid rgba(255,255,255,0.2);\n            border-radius: 6px;\n            padding: 2px;\n            background: rgba(0,0,0,0.3);\n        }\n        .theme-pill button, .lang-pill button {\n            background: none;\n            border: none;\n            color: #9ca3af;\n            font-size: 11px;\n            font-weight: 700;\n            padding: 4px 8px;\n            border-radius: 4px;\n            cursor: pointer;\n            transition: 0.2s;\n        }\n        .theme-pill button.active, .lang-pill button.active {\n            background: #ffffff;\n            color: #000000;\n        }\n    </style>\n</head>\n<body class=\"dark\">\n\n    <!-- Top Announcement Bar -->\n        <div style=\"background:#0a0a0b;color:#a3a3a3;font-size:12px;padding:8px 24px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.05);\">\n        <div style=\"display:flex;align-items:center;gap:8px;\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            <span>U3 STORE — LIVE YOURS. | شحن لجميع محافظات مصر الـ 27</span>\n        </div>\n        <div>\n            <a href=\"/track-order\" style=\"color:#d4d4d8;text-decoration:none;font-weight:600;font-size:12px;\">تتبع الطلب</a>\n        </div>\n    </div>\n    \n    <!-- Main Navigation Bar -->\n    <header class=\"u3-navbar\">\n        <div style=\"max-width:1440px;margin:auto;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px;\">\n            <!-- Brand Logo -->\n            <a href=\"/\" style=\"display:flex;align-items:center;gap:14px;text-decoration:none;color:#ffffff;\">\n                <img src=\"/assets/img/logo.jpg\" alt=\"U3 STORE\" style=\"width:44px;height:44px;border-radius:50%;object-fit:cover;border:1.5px solid rgba(255,255,255,0.2);\">\n                <div>\n                    <div style=\"font-size:18px;font-weight:900;letter-spacing:1px;line-height:1.1;\">U3 STORE</div>\n                    <div style=\"font-size:10px;font-weight:700;color:#9ca3af;letter-spacing:1.5px;\">LIVE YOURS.</div>\n                </div>\n            </a>\n\n            <!-- Desktop Links -->\n            <nav style=\"display:none;\" class=\"md:flex items-center gap-2\">\n                <a href=\"/\" class=\"nav-link active\">الرئيسية</a>\n                                <a href=\"/shoes\" class=\"nav-link \">الأحذية</a>\n                                                <a href=\"/shop\" class=\"nav-link \">جميع المنتجات</a>\n                <a href=\"/new-arrivals\" class=\"nav-link \">وصل حديثاً</a>\n                <a href=\"/collections\" class=\"nav-link \">المجموعات</a>\n                <a href=\"/track-order\" class=\"nav-link \">تتبع الطلب</a>\n            </nav>\n\n            <!-- Action Controls (Theme, Lang, Search, Wishlist, Cart, Profile) -->\n            <div style=\"display:flex;align-items:center;gap:14px;\">\n                <!-- Theme Switcher -->\n                <div class=\"theme-pill\">\n                    <button type=\"button\" onclick=\"setSiteTheme('light')\" class=\"\">☼ Light</button>\n                    <button type=\"button\" onclick=\"setSiteTheme('dark')\" class=\"active\">☾ Dark</button>\n                </div>\n\n                <!-- Lang Switcher -->\n                <div class=\"lang-pill\">\n                    <button type=\"button\" onclick=\"setSiteLang('en')\" class=\"\">EN</button>\n                    <button type=\"button\" onclick=\"setSiteLang('ar')\" class=\"active\">AR</button>\n                </div>\n\n                <!-- Search -->\n                <a href=\"/shop\" title=\"Search\" style=\"color:#ffffff;display:flex;align-items:center;padding:6px;\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n                </a>\n\n                <!-- Wishlist -->\n                <a href=\"/account/wishlist\" title=\"Wishlist\" style=\"color:#ffffff;position:relative;display:flex;align-items:center;padding:6px;\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"/></svg>\n                                    </a>\n\n                <!-- Shopping Bag -->\n                <a href=\"/cart\" title=\"Shopping Bag\" style=\"color:#ffffff;position:relative;display:flex;align-items:center;padding:6px;\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z\"/><path d=\"M3 6h18\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg>\n                                    </a>\n\n                <!-- Account / Admin -->\n                <a href=\"/account/login\" style=\"color:#ffffff;display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;text-decoration:none;padding:6px;\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>\n                                    </a>\n            </div>\n        </div>\n    </header>\n\n    <script>\n    function setSiteLang(lang) {\n        fetch('/api/lang', {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify({ lang: lang, scope: 'store' })\n        }).then(() => location.reload());\n    }\n    function setSiteTheme(theme) {\n        fetch('/api/theme', {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify({ theme: theme, scope: 'store' })\n        }).then(() => location.reload());\n    }\n    </script>\n\n\n<!-- Hero Section -->\n<section style=\"background:#0a0a0b;color:#ffffff;padding:100px 24px 80px;text-align:center;position:relative;overflow:hidden;border-bottom:1px solid rgba(255,255,255,0.08);\">\n    <div style=\"max-width:900px;margin:auto;position:relative;z-index:2;\">\n        <div style=\"display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);padding:6px 16px;border-radius:9999px;font-size:11px;font-weight:800;letter-spacing:2px;margin-bottom:24px;text-transform:uppercase;\">\n            <span>✨ U3 STORE — اصنع أسلوبك الخاص</span>\n        </div>\n        <h1 style=\"font-size:clamp(32px, 5vw, 64px);font-weight:900;letter-spacing:-1px;line-height:1.1;margin-bottom:20px;\">\n            اخطُ في مسارك الخاص.        </h1>\n        <p style=\"font-size:clamp(15px, 2vw, 18px);color:#a1a1aa;max-width:600px;margin:0 auto 36px;line-height:1.6;\">\n            اكتشف المجموعة. أحذية فاخرة بتصميم عصري يعبّر عن هويتك المتفردة.        </p>\n        <div style=\"display:flex;justify-content:center;gap:16px;flex-wrap:wrap;\">\n            <a href=\"/shop\" style=\"background:#ffffff;color:#000000;padding:16px 40px;font-size:14px;font-weight:800;letter-spacing:1px;border-radius:8px;text-decoration:none;transition:transform 0.2s, background 0.2s;\" onmouseover=\"this.style.background='#e5e5e5'\" onmouseout=\"this.style.background='#ffffff'\">\n                تسوق الآن →\n            </a>\n            <a href=\"/size-guide\" style=\"background:rgba(255,255,255,0.08);color:#ffffff;border:1px solid rgba(255,255,255,0.2);padding:16px 32px;font-size:14px;font-weight:700;border-radius:8px;text-decoration:none;transition:0.2s;\" onmouseover=\"this.style.background='rgba(255,255,255,0.15)'\" onmouseout=\"this.style.background='rgba(255,255,255,0.08)'\">\n                دليل المقاسات            </a>\n        </div>\n    </div>\n</section>\n\n<!-- Benefits Strip (Screenshot 9) -->\n<section style=\"max-width:1440px;margin:40px auto 20px;padding:0 24px;\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:20px;\">\n        <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:24px;display:flex;align-items:flex-start;gap:16px;box-shadow:0 2px 8px rgba(0,0,0,0.02);\">\n            <div style=\"background:#27272a;padding:12px;border-radius:10px;display:flex;align-items:center;justify-content:center;\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"/><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg>\n            </div>\n            <div>\n                <h4 style=\"font-size:14px;font-weight:800;margin-bottom:6px;letter-spacing:0.5px;\">\n                    توصيل لجميع المحافظات الـ 27                </h4>\n                <p style=\"font-size:12px;color:#a1a1aa;line-height:1.5;\">\n                    شحن مباشر حتى باب المنزل بأسعار واضحة وتتبع لحظي لحالة الطلب.                </p>\n            </div>\n        </div>\n\n        <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:24px;display:flex;align-items:flex-start;gap:16px;box-shadow:0 2px 8px rgba(0,0,0,0.02);\">\n            <div style=\"background:#27272a;padding:12px;border-radius:10px;display:flex;align-items:center;justify-content:center;\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"/></svg>\n            </div>\n            <div>\n                <h4 style=\"font-size:14px;font-weight:800;margin-bottom:6px;letter-spacing:0.5px;\">\n                    إنستاباي وفودافون كاش + فاتورة رسمية                </h4>\n                <p style=\"font-size:12px;color:#a1a1aa;line-height:1.5;\">\n                    تحويل فوري سهل ومراجعة سريعة للإيصال مع إمكانية طباعة وتحميل الفاتورة.                </p>\n            </div>\n        </div>\n\n        <div style=\"background:#18181b;border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:24px;display:flex;align-items:flex-start;gap:16px;box-shadow:0 2px 8px rgba(0,0,0,0.02);\">\n            <div style=\"background:#27272a;padding:12px;border-radius:10px;display:flex;align-items:center;justify-content:center;\">\n                <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            </div>\n            <div>\n                <h4 style=\"font-size:14px;font-weight:800;margin-bottom:6px;letter-spacing:0.5px;\">\n                    شراء سريع كزائر بدون تعقيد                </h4>\n                <p style=\"font-size:12px;color:#a1a1aa;line-height:1.5;\">\n                    إتمام الطلب في ثوانٍ مع سلة خاصة وخصوصية تامة بدون إنشاء حساب إجباري.                </p>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Shop By Category Cards (Screenshot 5) -->\n<section style=\"max-width:1440px;margin:40px auto 20px;padding:0 24px;\">\n    <div style=\"display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;\">\n        <div>\n            <span style=\"font-size:11px;font-weight:800;color:#71717a;letter-spacing:1px;text-transform:uppercase;\">EXPLORE ESSENTIALS</span>\n            <h2 style=\"font-size:24px;font-weight:900;margin-top:4px;\">SHOP BY CATEGORY</h2>\n        </div>\n        <a href=\"/shop\" style=\"font-size:13px;font-weight:700;color:inherit;text-decoration:none;\">SHOP ALL →</a>\n    </div>\n\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;\">\n                <a href=\"/shoes\" style=\"text-decoration:none;color:#ffffff;display:block;border-radius:16px;overflow:hidden;position:relative;height:240px;background:#111;box-shadow:0 8px 30px rgba(0,0,0,0.12);\">\n            <img src=\"/assets/img/logo.jpg\" alt=\"Shoes\" style=\"width:100%;height:100%;object-fit:cover;opacity:0.6;transition:transform 0.5s;\" onmouseover=\"this.style.transform='scale(1.05)'\" onmouseout=\"this.style.transform='scale(1)'\">\n            <div style=\"position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);padding:24px;display:flex;flex-direction:column;justify-content:space-between;\">\n                <span style=\"background:rgba(255,255,255,0.2);backdrop-filter:blur(8px);align-self:flex-start;padding:4px 12px;border-radius:9999px;font-size:11px;font-weight:800;letter-spacing:1px;\">👟 FOOTWEAR</span>\n                <div>\n                    <h3 style=\"font-size:28px;font-weight:900;margin-bottom:4px;\">الأحذية</h3>\n                    <span style=\"font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:6px;\">EXPLORE SHOES →</span>\n                </div>\n            </div>\n        </a>\n        \n            </div>\n</section>\n\n<!-- New Arrivals Carousel (Screenshot 6) -->\n<section style=\"max-width:1440px;margin:60px auto 40px;padding:0 24px;\">\n    <div style=\"display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px;\">\n        <div>\n            <div style=\"display:flex;align-items:center;gap:6px;font-size:11px;font-weight:800;color:#71717a;letter-spacing:1.5px;text-transform:uppercase;\">\n                <span>❖ EXCLUSIVE COLLECTION</s